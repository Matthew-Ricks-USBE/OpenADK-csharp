        <xs:complexType>
          <xs:sequence>
            <xs:element name="LocationName" minOccurs="0" nillable="true" type="xs:token">
              <xs:annotation>
                <xs:documentation>Name of the location</xs:documentation>
              </xs:annotation>
            </xs:element>
