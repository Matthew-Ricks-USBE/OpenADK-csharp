        <xs:complexType>
          <xs:sequence>
            <xs:element name="BudgetAccount" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="AccountClass" minOccurs="0">
