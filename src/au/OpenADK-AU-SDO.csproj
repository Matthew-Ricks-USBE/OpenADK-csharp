<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenADK.Library.au</RootNamespace>
    <AssemblyName>OpenADK.SDO-AU</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>UtahPublicEd.OpenADK.SDO-AU</PackageId>
    <Version>$(PackageVersion)</Version>
    <Authors>Access4Learning;Utah State Board of Education</Authors>
    <Description>Australian (AU) SIF Data Object (SDO) library.</Description>
    <RepositoryUrl>https://dev.azure.com/UtahPublicEd/USIMS/_git/student-openadk-csharp-service</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\SifWorks.Sdo-AU.XML</DocumentationFile>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\OpenADK-NET-Core.csproj" />
  </ItemGroup>
</Project>