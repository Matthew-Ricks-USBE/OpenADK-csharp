<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
	<IsTestProject>false</IsTestProject><!-- Test helpers, not a test project. -->
    <RootNamespace>OpenADK.UnitTesting</RootNamespace>
    <AssemblyName>OpenADK.UnitTesting</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <!-- Remove the capability flag that IDE extensions use for test discovery. -->
    <ProjectCapability Remove="TestContainer" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.0.1" />
    <PackageReference Include="xunit.v3.assert" Version="3.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\OpenADK-NET-Core.csproj" />
  </ItemGroup>
</Project>